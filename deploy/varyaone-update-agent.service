# Varya One host-side update agent.
# Installed and enabled by: ./deploy.sh install-agent
# The installer rewrites User=, WorkingDirectory= and ExecStart= for this host.

[Unit]
Description=Varya One update agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
ExecStart=/bin/sh __REPO_DIR__/deploy/varyaone-update-agent.sh
Restart=always
RestartSec=15
# The agent shells out to `docker compose` and `git`; keep the environment lean.
Environment=VARYAONE_REPO_DIR=__REPO_DIR__

[Install]
WantedBy=multi-user.target
