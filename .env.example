POSTGRES_DB=varyaone
POSTGRES_USER=varyaone
POSTGRES_PASSWORD=change-me
VARYAONE_ENV=development
VARYAONE_HTTP_ADDR=:8080
VARYAONE_LOG_LEVEL=info
VARYAONE_RELEASE=dev
# Generate with: openssl rand -base64 32
VARYAONE_MASTER_KEY=replace-with-base64-encoded-32-byte-key
VARYAONE_API_INTERNAL_URL=http://localhost:8080
# Firma izolasyonu row-level-security ile zorlansin diye sunucu/worker'ın
# bağlandığı, superuser OLMAYAN rol. `./deploy.sh` fresh install bunları otomatik
# üretir (varyaone_app rolü + parola). Boş bırakılırsa VARYAONE_DATABASE_URL
# (superuser) kullanılır ve RLS şeffaf kalır. Elle etkinleştirme:
#   docker compose exec -T postgres psql -U varyaone -d varyaone \
#     -f - < internal/platform/migrations/app_role.sql
#   docker compose exec -T postgres psql -U varyaone -d varyaone \
#     -c "ALTER ROLE varyaone_app LOGIN PASSWORD '<parola>'"
# VARYAONE_APP_DB_PASSWORD=
# VARYAONE_APP_DATABASE_URL=postgres://varyaone_app:<parola>@postgres:5432/varyaone?sslmode=disable
# Browser-facing origin used by the frontend's production CSRF check.
# Domainli kurulumda deploy.sh bunu otomatik https://<alan-adi> yapar.
VARYAONE_WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Portlar ve ag baglama (deploy.sh yonetir ama elle de degistirebilirsin)
# ---------------------------------------------------------------------------
# Domainsiz kurulumda tarayicinin gordugu portlar:
VARYAONE_WEB_PORT=3000
VARYAONE_API_PORT=8080
# Host arayuzu. Domainli kurulumda deploy.sh bunlari 127.0.0.1 yapar; boylece
# frontend/api'ye disaridan dogrudan erisilemez, yalniz nginx uzerinden gecilir.
VARYAONE_WEB_BIND=0.0.0.0
VARYAONE_API_BIND=0.0.0.0
# PostgreSQL host'a HIC acilmaz (en guvenlisi). Gerekiyorsa compose.yaml'daki
# yorumlu 'ports' blogunu ac; MUTLAKA 127.0.0.1'e bagli birak.
# VARYAONE_POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Domainli kurulum + otomatik SSL (Let's Encrypt / certbot + nginx)
#   ./deploy.sh install   ->  sihirbazda "Domainli" secin
# ---------------------------------------------------------------------------
# Bunlari kurulum sihirbazi otomatik doldurur. Interaktif olmayan (CI) kurulumda
# elle doldurun: VARYAONE_DOMAIN dolu ise deploy.sh domainli moda gecer.
# VARYAONE_DOMAIN=
# VARYAONE_ACME_EMAIL=
# nginx'in dinledigi genel portlar:
VARYAONE_HTTP_PORT=80
VARYAONE_HTTPS_PORT=443
VARYAONE_STORAGE_PROVIDER=local
VARYAONE_STORAGE_ROOT=/var/lib/varyaone/storage
# S3/MinIO are optional; credentials are never logged.
# VARYAONE_STORAGE_ENDPOINT=http://minio:9000
# VARYAONE_STORAGE_BUCKET=varyaone
# VARYAONE_STORAGE_REGION=us-east-1
# VARYAONE_STORAGE_ACCESS_KEY=change-me
# VARYAONE_STORAGE_SECRET_KEY=change-me
# VARYAONE_STORAGE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Nabiz (varya-pulse) - anonim kullanim/kurulum bilgisi
# ---------------------------------------------------------------------------
# compose.yaml varsayilan olarak resmi toplayiciyi (varya-pulse.varyaone.workers.dev)
# ve paylasilan ingest anahtarini kullanir; asagidaki degiskenleri vermezsen
# bu varsayilanlar gecerlidir.
#
# 1) KURULUM SAYACI - varsayilan ACIK (opt-out)
#    Uygulama ilk acilista toplayiciya bir kez ping atar. Gonderilen: rastgele
#    kurulum UUID'si + surum. Sirket ismi / vergi no / veri ASLA gitmez.
#    Tamamen kapatmak icin:
# VARYAONE_PULSE_INSTALL_PING=false
#
# 2) GUNLUK KULLANIM OZETI - varsayilan KAPALI (opt-in)
#    Acarsan gunde bir kez sirket UUID'si bazinda sayaclari (kac cari, fatura,
#    teklif, irsaliye, urun, personel...) gonderir. Yine isim/tutar gitmez.
# VARYAONE_PULSE_ENABLED=true
#
# 3) Kendi toplayicini kullanmak istersen:
# VARYAONE_PULSE_ENDPOINT=https://kendi-worker.example.workers.dev
# VARYAONE_PULSE_INGEST_KEY=kendi-anahtarin
#
# Toplayiciyi tamamen devre disi birakmak: ikisini de bos ver
# VARYAONE_PULSE_ENDPOINT=
# VARYAONE_PULSE_INGEST_KEY=

# ---------------------------------------------------------------------------
# Otomatik guncelleme (host systemd agent)
# ---------------------------------------------------------------------------
# `./deploy.sh install` bu belirteci otomatik uretir. Host uzerindeki
# varyaone-update-agent servisi bununla /internal/update/* uclarina baglanir.
# Bos birakilirsa o uclar tamamen kapanir (arayuzden guncelleme baslatilamaz).
# Elle uretmek icin: openssl rand -hex 32
# VARYAONE_UPDATE_AGENT_TOKEN=
